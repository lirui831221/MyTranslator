{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Main window capabilities: core APIs used by index.html and overlay.html",
  "windows": ["main", "overlay"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:app:default"
  ]
}
