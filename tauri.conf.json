{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My Translator",
  "version": "0.3.0",
  "identifier": "com.rain.mytranslator",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "My Translator",
        "width": 900,
        "height": 640,
        "resizable": true,
        "center": true
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Subtitle",
        "width": 760,
        "height": 180,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"]
  }
}
